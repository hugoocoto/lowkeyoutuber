#!/usr/bin/env bash
# lky - entry point for people and AI agents (see AGENTS.md).
#
#   lky <command> ...        lky.py commands: new, add-media, status, check, backends, flows, skills
#   lky run <tool> ...       any tool with the toolkit's Python: lky run subtitles.py rec.mkv
#   lky pip install <pkg>    install a package into the toolkit's venv (never system-wide)
#   lky venv                 print the venv's path (created if missing)
#
# The venv: $LKY_VENV, else (installed as a Claude Code plugin) the plugin's data folder, else
# ~/.venvs/lowkeyoutuber. $PYTHON overrides the interpreter entirely.
set -euo pipefail
HERE="$(dirname "$(readlink -f "$0")")"

venv_dir() {
  if [[ -n "${LKY_VENV:-}" ]]; then echo "$LKY_VENV"; return; fi
  # a plugin is copied to <plugins>/cache/<marketplace>/<plugin>/<version>/; its data folder, kept
  # across updates, is <plugins>/data/<plugin>-<marketplace>/ (CLAUDE_PLUGIN_DATA isn't exported to shells)
  local ver plugin mkt cache plugins
  ver="$(dirname "$HERE/x")"; plugin="$(dirname "$ver")"; mkt="$(dirname "$plugin")"; cache="$(dirname "$mkt")"
  plugins="$(dirname "$cache")"
  if [[ "$(basename "$cache")" == cache && -d "$plugins/data" ]]; then
    echo "$plugins/data/$(basename "$plugin")-$(basename "$mkt")/venv"; return
  fi
  echo "$HOME/.venvs/lowkeyoutuber"
}

VENV="$(venv_dir)"
ensure_venv() {
  if [[ ! -x "$VENV/bin/python" ]]; then
    echo "lky: creating the toolkit's venv at $VENV" >&2
    mkdir -p "$(dirname "$VENV")"
    python3 -m venv "$VENV"
  fi
}

case "${1:-}" in
  venv) ensure_venv; echo "$VENV"; exit 0 ;;
  pip) shift; ensure_venv; exec "$VENV/bin/python" -m pip "$@" ;;
esac

if [[ -n "${PYTHON:-}" ]]; then PY="$PYTHON"; else ensure_venv; PY="$VENV/bin/python"; fi

if [[ "${1:-}" == run ]]; then
  shift
  tool="${1:?usage: lky run <tool> [args...]}"; shift
  [[ "$tool" == */* ]] || tool="$HERE/$tool"
  case "$tool" in
    *.sh) exec bash "$tool" "$@" ;;
    *) exec "$PY" "$tool" "$@" ;;
  esac
fi
exec "$PY" "$HERE/lky.py" "$@"
